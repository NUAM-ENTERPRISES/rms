# Copy to backend/.env (never commit .env)
# Same file for local dev, Docker dev, and Docker production — use different values per machine.

# Database (native npm dev only — Docker compose overrides DATABASE_URL at runtime)
# DB client extension / psql from Mac: host 127.0.0.1 port 5433 (Docker maps 5433→container 5432)
DATABASE_URL="postgresql://postgres:password@localhost:5433/affiniks_rms?schema=public"

# PostgreSQL (Docker postgres service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=affiniks_rms

# Redis (native npm dev only — Docker compose overrides REDIS_* at runtime)
REDIS_PASSWORD=change-me-in-production
REDIS_URL="redis://localhost:6379"
# Production Docker example (set on server backend/.env):
# REDIS_PASSWORD=your-strong-random-password
# REDIS_URL="redis://:your-strong-random-password@redis:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3000
NODE_ENV=development

# CORS — comma-separated allowed frontend origins (no trailing slash)
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
# Production example:
# CORS_ORIGIN="https://rms.affiniks.com"

# Public URLs (production Docker web build — dev Docker web uses compose defaults)
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=http://localhost:3000

# Seed / logging
SEED_ADMIN_PASSWORD=admin123
LOG_LEVEL=info

# DigitalOcean Spaces
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_SYNC_CORS=false

# Meta / Facebook
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# Instagram Messaging
META_IG_ACCOUNT_ID=
INSTAGRAM_PAGE_ACCESS_TOKEN=

# WhatsApp
WHATSAPP_ENABLED=true
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_URL=https://graph.facebook.com/v24.0/
# Public HTTPS image for status template IMAGE headers (required for candidate_status_*)
WHATSAPP_TEMPLATE_HEADER_IMAGE_URL=https://blr1.digitaloceanspaces.com/affiniks-rms-prod-ind1/candidates/profiles/cmrolihxf000gnr4tkhf403jf/Gemini-Generated-Image-lmq9nblmq9nblmq9-1785001273244-eeb9c580dcc85aa4.png

# MSG91 OTP
MSG91_AUTHKEY=
MSG91_SENDERID=
MSG91_TEMPLATEID=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Drive (if used)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_DRIVE_PARENT_FOLDER_ID=

# Google Vertex AI / Gemini — resume analysis, Excel import mapping, and
# merged-PDF classification. Same GCP project as RAIMS resume analysis.
# Local Docker: compose mounts host ADC (~/.config/gcloud/application_default_credentials.json)
# to /gcp/adc.json. Optional service-account PEM takes precedence over ADC.
# Without these the import wizard still runs, but every unmatched qualification
# or department falls through to manual review instead of being suggested.
GOOGLE_CLOUD_PROJECT=resume-analyst-ai-504411
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.1-flash-lite
VERTEX_TIMEOUT_MS=120000
# VERTEX_SA_EMAIL=
# Paste the PEM with literal \n escapes, exactly like GOOGLE_PRIVATE_KEY.
# VERTEX_PRIVATE_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/gcp/adc.json
